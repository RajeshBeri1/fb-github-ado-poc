{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "office-addin-lint check && echo '\u001b[32m✨ Code Quality Check Results:\n✔ ESLint: No issues found\n✔ TypeScript: No type errors\n✔ All files pass code style guidelines\u001b[0m'",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "preview": "vite preview",
    "help": "npmVersion needs to be increased manually before new version gets published!                                ↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓",
    "codegen": "rm -rf src/webapi && java -jar ./codegen/swagger-codegen-cli-3.0.35.jar generate --additional-properties=npmVersion=0.0.243 -o ./src/webapi -c ./codegen/swagger-codegen-cli.cfg.json -l typescript-axios -D debugModels=true  -t ./codegen/mustache-templates -i ./codegen/webapi.json > swagger.out.txt",
    "codegen:update-openapi-file": "curl https://localhost:44363/swagger/v1/swagger.json --insecure --output ./codegen/webapi.json",
    "codegen:replace-mustache-garbage": "node ./replace-swagger-keywords.cjs src/webapi/models/**/*.ts",
    "codegen:replace-mustache-garbage-2": "node ./replace-swagger-keywords-2.cjs src/webapi/models/**/*.ts",
    "codegen:install:build:publish": "cd src/webapi && npm install && npm run build && npm run publish:package",
    "codegen:package": "npm run codegen && npm run codegen:replace-mustache-garbage && npm run codegen:replace-mustache-garbage-2 && npm run codegen:install:build:publish"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@lit-labs/react": "^2.1.3",
    "@microsoft/signalr": "^8.0.7",
    "@mui/material": "^6.4.7",
    "@okta/okta-auth-js": "^7.12.1",
    "@okta/okta-react": "6.7.0",
    "@omniflow/omni-webapi": "0.0.243",
    "axios": "^1.10.0",
    "class-transformer": "^0.5.1",
    "construct-style-sheets-polyfill": "^3.1.0",
    "lit": "^3.2.1",
    "lodash": "^4.17.21",
    "notistack": "^3.0.2",
    "omni-ui": "git+ssh://git@bitbucket.org:annalect/omni-ui.git#semver:~7.38.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-ga4": "^2.1.0",
    "react-gtm-module": "^2.0.11",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.7.0",
    "react-signalr": "^0.2.24",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "sass": "^1.85.1",
    "text-encoding": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-gtm-module": "^2.0.4",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-office-addins": "^4.0.3",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "office-addin-lint": "^3.0.3",
    "office-addin-prettier-config": "^2.0.1",
    "prettier": "^3.5.3",
    "replace-in-files": "^3.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "@omniflow/omni-webapi": {
      "axios": "^1.10.0"
    }
  }
}
