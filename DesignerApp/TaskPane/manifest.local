<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
	xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>89a8fb5f-050f-46e5-a5b4-337a11995842</Id>
  <Version>1.0.0.3</Version>
  <ProviderName>Omnicom Media Group</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Flowchart Builder - Annalect Dev"/>
  <Description DefaultValue="Omnicom Media Group Flowchart Designer" />
  <IconUrl DefaultValue="https://mcs-dev-designerapp-eastus.yellowhill-44cae165.eastus.azurecontainerapps.io/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://mcs-dev-designerapp-eastus.yellowhill-44cae165.eastus.azurecontainerapps.io/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://www.omnicomgroup.com/about/" />
  <AppDomains>
    <AppDomain>https://onewp.okta.com</AppDomain>
    <AppDomain>https://omnicomgroup.okta.com</AppDomain>
    <AppDomain>https://oneomg.okta.com</AppDomain>
    <AppDomain>https://dev-152662.okta.com</AppDomain>
    <AppDomain>https://mcs-dev-designerapp-eastus.yellowhill-44cae165.eastus.azurecontainerapps.io</AppDomain>
    <AppDomain>https://mcs-dev-designerapp-eastus.yellowhill-44cae165.eastus.azurecontainerapps.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook" />
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://mcs-dev-designerapp-eastus.yellowhill-44cae165.eastus.azurecontainerapps.io/taskpane.html" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="CommandsGroup">
                <Label resid="CommandsGroup.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="RunButton">
                  <Label resid="RunButton.Label" />
                  <Supertip>
                    <Title resid="RunButton.Label" />
                    <Description resid="RunButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Office.AutoShowTaskpaneWithDocument</TaskpaneId>
                    <SourceLocation resid="RunTaskpane.Url" />
                  </Action>
                </Control>
                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Office.AutoShowTaskpaneWithDocument</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://mcs-dev-designerapp-eastus.yellowhill-44cae165.eastus.azurecontainerapps.io/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://mcs-dev-designerapp-eastus.yellowhill-44cae165.eastus.azurecontainerapps.io/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://mcs-dev-designerapp-eastus.yellowhill-44cae165.eastus.azurecontainerapps.io/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://go.microsoft.com/fwlink/?LinkId=276812" />
        <bt:Url id="Commands.Url" DefaultValue="https://mcs-dev-designerapp-eastus.yellowhill-44cae165.eastus.azurecontainerapps.io/commands.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://mcs-dev-designerapp-eastus.yellowhill-44cae165.eastus.azurecontainerapps.io/taskpane.html" />
        <bt:Url id="RunTaskpane.Url" DefaultValue="https://mcs-dev-designerapp-eastus.yellowhill-44cae165.eastus.azurecontainerapps.io/taskpane.html?mode=run" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Get started with flowchart tools!" />
        <bt:String id="CommandsGroup.Label" DefaultValue="Flowchart Builder - Annalect Dev" />
        <bt:String id="TaskpaneButton.Label" DefaultValue="Edit" />
        <bt:String id="RunButton.Label" DefaultValue="Run" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Flowchart tools loaded successfully. Go to the 'Flowcharts' tab and click the 'Edit' button to get started." />
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Click to open the flowchart designer" />
        <bt:String id="RunButton.Tooltip" DefaultValue="Click to open run a flowchart" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
